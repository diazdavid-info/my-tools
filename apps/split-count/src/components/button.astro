---
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a
  href={href}
  class="shadow-button flex h-14 items-center justify-center gap-2.5 rounded-xl bg-accent text-[17px] font-semibold text-paper-white transition-transform active:scale-[0.98]"
>
  <slot />
  <svg
    class="size-5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M5 12h14" />
    <path d="m12 5 7 7-7 7" />
  </svg>
</a>
