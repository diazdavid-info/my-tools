{
  "name": "api-route",
  "version": "0.1.0",
  "description": "Basic framework for your API in Node.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "tsx watch --include 'src/**/*.{ts,js}' --include 'example/**/*.{ts,js}' example/index.ts",
    "dev:example": "tsx example/index.ts",
    "lint": "eslint . --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diazdavid-info/my-tools.git",
    "directory": "apps/api-route"
  },
  "keywords": [
    "api",
    "framework",
    "node",
    "express"
  ],
  "author": "David Diaz",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint-config-mytools": "workspace:^",
    "mytools-tsconfig": "workspace:^",
    "rimraf": "6.1.4",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "http-parser-js": "^0.5.10",
    "path-to-regexp": "^9.0.0"
  }
}
